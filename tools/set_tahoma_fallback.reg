Windows Registry Editor Version 5.00

; INKTTS — บังคับให้ Windows ใช้ Tahoma แทน Segoe UI / MS Sans Serif ทุกที่ที่ระบบ
; เรียกชื่อฟอนต์เหล่านั้น (รวมโปรแกรมอื่น ๆ ที่ฝัง Segoe UI ไว้ default)
;
; วิธีใช้:
;   1. ดับเบิลคลิกไฟล์นี้ → ตอบ Yes ให้ UAC
;   2. รีสตาร์ทเครื่อง (หรือ logoff/login) ผลถึงจะ apply ทุกแอป
;
; ย้อน:
;   ดับเบิลคลิก tools\restore_default_fonts.reg
;
; หมายเหตุ: การเปลี่ยน Segoe UI → Tahoma กระทบ Windows UI เอง
; (Start menu, File Explorer ฯลฯ) อาจไม่สวยกับบางส่วนของ Windows.

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\FontSubstitutes]
"Segoe UI"="Tahoma"
"Segoe UI Black"="Tahoma"
"Segoe UI Bold"="Tahoma"
"Segoe UI Historic"="Tahoma"
"Segoe UI Light"="Tahoma"
"Segoe UI Semibold"="Tahoma"
"Segoe UI Semilight"="Tahoma"
"Segoe UI Symbol"="Tahoma"
"MS Shell Dlg"="Tahoma"
"MS Shell Dlg 2"="Tahoma"
"MS Sans Serif"="Tahoma"
"Helv"="Tahoma"
