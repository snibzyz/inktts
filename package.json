{
  "name": "inktts-workspace",
  "version": "2.0.3",
  "private": true,
  "description": "INKTTS — Thai batch text-to-speech desktop app",
  "scripts": {
    "dev": "pnpm --filter @inktts/desktop-shell dev",
    "build": "pnpm --filter @inktts/desktop-shell build",
    "test": "pnpm --filter @inktts/desktop-shell test",
    "package:win": "pnpm --filter @inktts/desktop-shell package:win",
    "publish:win": "pnpm --filter @inktts/desktop-shell publish:win",
    "package:mac": "pnpm --filter @inktts/desktop-shell package:mac",
    "publish:mac": "pnpm --filter @inktts/desktop-shell publish:mac",
    "release": "node scripts/release.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "tts",
    "thai"
  ],
  "author": "INKREALM",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "ffmpeg-static",
      "esbuild"
    ]
  }
}
