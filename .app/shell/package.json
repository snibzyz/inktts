{
  "name": "@inktts/desktop-shell",
  "version": "2.0.10",
  "private": true,
  "description": "INKTTS desktop shell — Electron + React renderer",
  "author": {
    "name": "INKREALM",
    "email": "support@inkrealm.co",
    "url": "https://inkrealm.co"
  },
  "homepage": "https://inkrealm.co/programs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5473 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:tts": "node electron/__tests__/smoke-tts.cjs",
    "smoke:merge": "node electron/__tests__/smoke-merge.cjs",
    "package:win": "pnpm build && electron-builder --win nsis portable",
    "publish:win": "pnpm build && electron-builder --win nsis portable --publish always",
    "package:mac": "pnpm build && electron-builder --mac dmg zip",
    "publish:mac": "pnpm build && electron-builder --mac dmg zip --publish always"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.5",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.inktts.app",
    "productName": "INKTTS",
    "copyright": "© 2026 INKREALM",
    "afterPack": "build/afterPack.cjs",
    "afterSign": "build/afterSign.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/__tests__/**",
      "package.json",
      "public/**/*",
      "node_modules/ffmpeg-static/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "snibzyz",
        "repo": "inktts"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "INKTTS",
      "artifactName": "INKTTS-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "INKTTS-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "public/logo.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "10.15.0",
      "artifactName": "INKTTS-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 INKREALM",
        "LSApplicationCategoryType": "public.app-category.utilities",
        "CFBundleDisplayName": "INKTTS",
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "dmg": {
      "writeUpdateInfo": false,
      "title": "INKTTS ${version}",
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
